digraph SemanticNetwork {
    rankdir=LR;
    node [shape=box, style=filled, fillcolor=lightblue, fontname="Arial"];
    edge [color=navy, fontname="Arial"];

    // Вершины
    Компьютерная_сеть [fillcolor=lightyellow];
    Топология;
    Оборудование;
    Устройство;
    Протокол;
    Безопасность;
    Тестирование;
    Требования;
    Локальная_сеть_LAN;
    Беспроводная_сеть_WLAN;
    Звезда;
    Роутер;
    Коммутатор;
    Кабель;
    Компьютер;
    Сервер;
    TCP_IP;
    DHCP;
    Firewall;
    Шифрование_WPA3;
    Ping;
    Бюджет;
    Площадь;
    TP_Link_Archer_C6 [fillcolor=lightgreen];
    TP_Link_TL_SG1016D [fillcolor=lightgreen];

    // Связи
    Локальная_сеть_LAN -> Компьютерная_сеть [label="является наследником"];
    Беспроводная_сеть_WLAN -> Компьютерная_сеть [label="является наследником"];
    Звезда -> Топология [label="является частью"];
    Роутер -> Оборудование [label="является частью"];
    Коммутатор -> Оборудование [label="является частью"];
    Кабель -> Оборудование [label="является частью"];
    Компьютер -> Устройство [label="является наследником"];
    Сервер -> Устройство [label="является наследником"];
    TCP_IP -> Протокол [label="является экземпляром"];
    DHCP -> Протокол [label="является экземпляром"];
    Firewall -> Безопасность [label="является частью"];
    Шифрование_WPA3 -> Безопасность [label="является частью"];
    Ping -> Тестирование [label="является частью"];
    Бюджет -> Требования [label="является атрибутом"];
    Площадь -> Требования [label="является атрибутом"];
    TP_Link_Archer_C6 -> Роутер [label="является экземпляром"];
    TP_Link_TL_SG1016D -> Коммутатор [label="является экземпляром"];
    Компьютерная_сеть -> Топология [label="использует"];
    Компьютерная_сеть -> Оборудование [label="состоит из"];
    Компьютерная_сеть -> Безопасность [label="обеспечивает"];
    Тестирование -> Компьютерная_сеть [label="проверяет после"];
    Требования -> Компьютерная_сеть [label="определяют"];
    Устройство -> Компьютерная_сеть [label="является частью"];
    Компьютер -> Компьютерная_сеть [label="подключён к"];
    Сервер -> Компьютерная_сеть [label="подключён к"];
    Протокол -> Компьютерная_сеть [label="используется в"];
    TCP_IP -> Компьютерная_сеть [label="управляет обменом"];
    DHCP -> TCP_IP [label="распределяет IP"];
    Firewall -> TCP_IP [label="фильтрует трафик"];
}