INSERT INTO ProcessingFrameworkWorkflow (FrameworkID, WorkflowID) VALUES
-- Связывает, какой фреймворк используется в каком рабочем процессе
(401, 801), -- Spark используется в ежедневном ETL
(401, 802), -- Spark используется в еженедельном отчете
(402, 804), -- Flink используется в потоковой обработке (каждые 10 мин)
(403, 803), -- dbt используется для ежемесячной витрины данных
(404, 801), -- Kubeflow используется для ежедневного переобучения модели
(404, 802); -- Kubeflow используется для еженедельной оценки модели
</sql><current_tab id="0"/></tab_sql></sqlb_project>
